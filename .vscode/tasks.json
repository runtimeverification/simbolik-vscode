// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build:dev",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$tsc"],
			"label": "npm: build:dev",
			"detail": "Build packages (tsc -b) + extension (tsc) + server bundle (esbuild) — the full F5 dev build"
		},
		{
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": ["$tsc"],
			"label": "npm: compile",
			"detail": "tsc -p ./ (extension source only — does NOT rebuild build/server.mjs)"
		},
	]
}
